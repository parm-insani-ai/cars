// Frontdesk — Voice AI phone receptionist for small businesses.
//
// Multi-tenant: every domain row is scoped to a Business.
// Three verticals share one model: dealership, service_shop, wellness.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Tenancy & businesses -------------------------------------------------

model Account {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  businesses Business[]
}

enum Vertical {
  dealership
  service_shop
  wellness
}

enum BusinessTimezone {
  // Stored as IANA string on Business.timezone; this enum unused but
  // kept here as a marker for the migration we'll do later.
  America_Los_Angeles
}

model Business {
  id              String   @id @default(cuid())
  accountId       String
  name            String
  vertical        Vertical
  timezone        String   @default("America/Los_Angeles")
  phoneNumber     String?  // E.164. The number Vapi listens on for this business.
  vapiAssistantId String?  // Vapi assistant id once provisioned.
  // SMS confirmations are sent FROM this number (defaults to phoneNumber).
  smsFromNumber   String?

  // --- Stripe (deposits & cards on file) -------------------------------
  stripeAccountId       String?
  stripeAccessToken     String?
  depositsEnabled       Boolean  @default(false)
  defaultDepositCents   Int?      // fallback if a service doesn't set its own

  // --- Google Calendar -------------------------------------------------
  googleCalendarId      String?
  googleAccessToken     String?
  googleRefreshToken    String?
  googleTokenExpiresAt  DateTime?

  // --- End-of-day digest -----------------------------------------------
  digestEnabled         Boolean  @default(true)
  digestRecipientPhone  String?
  digestRecipientEmail  String?
  digestHourLocal       Int      @default(18)   // 0..23 — hour in business timezone

  agentConfig     AgentConfig?
  hours           BusinessHours[]
  services        Service[]
  providers       Provider[]
  customers       Customer[]
  callSessions    CallSession[]
  appointments    Appointment[]
  knowledge       KnowledgeArticle[]
  vehicles        Vehicle[]              // dealership pack only
  users           User[]
  followUps       FollowUp[]
  aiEvals         AiEval[]
  campaigns       Campaign[]
  smsThreads      SmsThread[]

  account         Account   @relation(fields: [accountId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AgentConfig {
  id            String   @id @default(cuid())
  businessId    String   @unique
  // Persona / voice profile that flavors the system prompt. Stable per business.
  greeting      String   @db.Text
  personality   String   @db.Text
  voiceProvider String   @default("11labs")   // 11labs | playht | azure | openai
  voiceId       String   @default("default")
  language      String   @default("en-US")
  // What the agent is allowed to do this call. Booleans gate tool availability.
  canBook       Boolean  @default(true)
  canReschedule Boolean  @default(true)
  canCancel     Boolean  @default(true)
  canTransfer   Boolean  @default(true)
  transferTo    String?  // E.164 number for "transfer to a human"
  // Compliance copy appended to outbound SMS confirmations.
  smsFooter     String   @default("Reply STOP to opt out.")
  business      Business @relation(fields: [businessId], references: [id])
}

model BusinessHours {
  id         String   @id @default(cuid())
  businessId String
  // 0 = Sunday … 6 = Saturday
  dayOfWeek  Int
  openMin    Int      // minutes from midnight, e.g. 9*60 = 540
  closeMin   Int      // e.g. 18*60 = 1080
  business   Business @relation(fields: [businessId], references: [id])
  @@unique([businessId, dayOfWeek])
}

// --- Users (admin / owner / staff) ---------------------------------------

enum Role {
  owner
  manager
  staff
  admin
}

model User {
  id         String   @id @default(cuid())
  businessId String
  email      String   @unique
  name       String
  role       Role     @default(staff)
  active     Boolean  @default(true)
  business   Business @relation(fields: [businessId], references: [id])
  createdAt  DateTime @default(now())
}

// --- Service catalog ------------------------------------------------------

model Service {
  id           String   @id @default(cuid())
  businessId   String
  name         String                 // "Test drive", "Oil change", "60-min Swedish massage"
  category     String?                // "test_drive", "maintenance", "massage", etc.
  durationMin  Int      @default(30)
  priceUsd     Float?
  // If true, customers can self-book without provider selection (any available).
  anyProvider  Boolean  @default(true)
  // Which provider kinds can deliver this service (e.g. "stylist", "mechanic", "sales_rep").
  providerKind String?
  description  String?  @db.Text
  active       Boolean  @default(true)
  // Deposit (Stripe). When set, the agent will request a deposit on book.
  depositRequired Boolean @default(false)
  depositCents    Int?    // amount in USD cents
  business     Business @relation(fields: [businessId], references: [id])
  appointments Appointment[]
  createdAt    DateTime @default(now())
  @@index([businessId, active])
}

// --- Providers (a stylist, mechanic, rep, doctor, bay, room) -------------

model Provider {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  kind         String   // sales_rep | mechanic | stylist | dentist | room | bay | massage_therapist | ...
  email        String?
  phone        String?
  // ICS feed url, Google Cal id, or null for "use our internal calendar"
  externalCalId String?
  active       Boolean  @default(true)
  business     Business @relation(fields: [businessId], references: [id])
  appointments Appointment[]
  shifts       ProviderShift[]
  createdAt    DateTime @default(now())
  @@index([businessId, kind, active])
}

model ProviderShift {
  id         String   @id @default(cuid())
  providerId String
  dayOfWeek  Int       // 0..6
  startMin   Int
  endMin     Int
  provider   Provider  @relation(fields: [providerId], references: [id])
  @@unique([providerId, dayOfWeek])
}

// --- Customers ------------------------------------------------------------

model Customer {
  id           String   @id @default(cuid())
  businessId   String
  firstName    String?
  lastName     String?
  phone        String?  // E.164
  email        String?
  smsConsent   Boolean  @default(false)
  emailConsent Boolean  @default(false)
  notes        String?  @db.Text
  tags         String[] @default([])
  business     Business @relation(fields: [businessId], references: [id])
  appointments Appointment[]
  callSessions CallSession[]
  ownedVehicles OwnedVehicle[]   // dealership pack
  campaignTargets CampaignTarget[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([businessId, phone])
  @@index([businessId, email])
}

// --- Vehicles (dealership pack only, kept lean) --------------------------

model Vehicle {
  id          String   @id @default(cuid())
  businessId  String
  stockNumber String
  vin         String?  @unique
  year        Int
  make        String
  model       String
  trim        String?
  bodyType    String?
  fuel        String?
  mileage     Int?
  price       Float
  isNew       Boolean  @default(true)
  status      String   @default("in_stock")
  business    Business @relation(fields: [businessId], references: [id])
  createdAt   DateTime @default(now())
  @@index([businessId, status])
}

model OwnedVehicle {
  id         String   @id @default(cuid())
  customerId String
  year       Int
  make       String
  model      String
  mileage    Int?
  customer   Customer @relation(fields: [customerId], references: [id])
}

// --- Appointments ---------------------------------------------------------

enum ApptStatus {
  pending          // proposed by agent, awaiting confirmation
  confirmed        // booked
  reminded         // 24h reminder sent
  arrived          // checked in
  completed        // service finished
  no_show
  canceled
  rescheduled
}

model Appointment {
  id           String   @id @default(cuid())
  businessId   String
  customerId   String?
  providerId   String?
  serviceId    String
  scheduledAt  DateTime
  durationMin  Int
  status       ApptStatus @default(pending)
  source       String   @default("agent")   // "agent" | "manual" | "web"
  notes        String?  @db.Text
  externalCalEventId String?    // Google Cal / Cal.com event id
  callSessionId String?           // call that booked this
  // Deposit / card on file
  depositCents      Int?
  depositStatus     String  @default("none")   // none | pending | paid | refunded | failed
  stripeCheckoutId  String?
  stripePaymentIntentId String?
  business     Business @relation(fields: [businessId], references: [id])
  customer     Customer? @relation(fields: [customerId], references: [id])
  provider     Provider? @relation(fields: [providerId], references: [id])
  service      Service   @relation(fields: [serviceId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([businessId, scheduledAt])
  @@index([businessId, status])
}

// --- Calls (the core surface of this product) ----------------------------

enum CallDirection {
  inbound
  outbound
}

enum CallOutcome {
  in_progress
  booked
  rescheduled
  canceled
  message_taken
  transferred
  no_action
  voicemail
  hung_up
}

model CallSession {
  id           String   @id @default(cuid())
  businessId   String
  customerId   String?
  vapiCallId   String?  @unique     // Vapi's id, when we have one
  direction    CallDirection
  outcome      CallOutcome    @default(in_progress)
  fromNumber   String
  toNumber     String
  startedAt    DateTime
  endedAt      DateTime?
  durationSec  Int?
  recordingUrl String?
  summary      String?  @db.Text
  transcript   String?  @db.Text   // raw text fallback; turns table is canonical
  // Whether the conversation reached a booked appointment.
  bookedApptId String?
  cost         Float?              // platform cost reported by Vapi, USD
  business     Business @relation(fields: [businessId], references: [id])
  customer     Customer? @relation(fields: [customerId], references: [id])
  turns        CallTurn[]
  toolCalls    CallToolCall[]
  @@index([businessId, startedAt])
  @@index([businessId, outcome])
}

enum TurnRole {
  agent
  customer
  system
  tool
}

model CallTurn {
  id         String   @id @default(cuid())
  sessionId  String
  role       TurnRole
  text       String   @db.Text
  startedAt  DateTime @default(now())
  session    CallSession @relation(fields: [sessionId], references: [id])
  @@index([sessionId, startedAt])
}

model CallToolCall {
  id         String   @id @default(cuid())
  sessionId  String
  toolName   String
  input      Json
  output     Json
  isError    Boolean  @default(false)
  latencyMs  Int
  createdAt  DateTime @default(now())
  session    CallSession @relation(fields: [sessionId], references: [id])
  @@index([sessionId, createdAt])
}

// --- Knowledge base (agent uses this to answer FAQs) ---------------------

model KnowledgeArticle {
  id         String   @id @default(cuid())
  businessId String
  title      String
  body       String   @db.Text
  tags       String[] @default([])
  business   Business @relation(fields: [businessId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([businessId])
}

// --- Follow-ups (scheduled outbound work) -------------------------------

enum FollowUpKind {
  pre_appt_reminder
  no_show_recovery
  missed_call_callback
  post_call_followup
}

enum FollowUpStatus {
  scheduled
  sent
  failed
  canceled
  skipped
}

enum FollowUpChannel {
  sms
  voice
  email
}

model FollowUp {
  id          String   @id @default(cuid())
  businessId  String
  customerId  String?
  apptId      String?
  callSessionId String?
  kind        FollowUpKind
  channel     FollowUpChannel
  scheduledFor DateTime
  status      FollowUpStatus  @default(scheduled)
  payload     Json?          // body / variables
  sentAt      DateTime?
  errorMessage String?
  business    Business @relation(fields: [businessId], references: [id])
  createdAt   DateTime @default(now())
  @@index([businessId, status, scheduledFor])
}

// --- AI evaluation artifacts --------------------------------------------

model AiEval {
  id         String   @id @default(cuid())
  businessId String?
  task       String   // turn | summarize | classify_outcome | ...
  input      Json
  output     Json
  model      String
  latencyMs  Int
  cacheReadTokens     Int @default(0)
  cacheCreationTokens Int @default(0)
  inputTokens  Int   @default(0)
  outputTokens Int   @default(0)
  createdAt  DateTime @default(now())
  business   Business? @relation(fields: [businessId], references: [id])
  @@index([task, createdAt])
}

// --- Outbound campaigns -------------------------------------------------
// "Call every customer we haven't seen in 6+ months and offer them a slot."

enum CampaignStatus {
  draft
  scheduled
  running
  paused
  completed
  canceled
}

enum CampaignTargetStatus {
  pending
  calling
  completed
  failed
  skipped
  opted_out
}

model Campaign {
  id            String   @id @default(cuid())
  businessId    String
  name          String
  status        CampaignStatus @default(draft)
  // Plain-English description of the campaign goal — used in the agent prompt.
  goal          String   @db.Text
  // Quiet hours (per business timezone). Inclusive of start, exclusive of end.
  quietStartHour Int     @default(20)   // 8pm
  quietEndHour   Int     @default(9)    // 9am
  // Max outbound calls per minute, to stay polite and within carrier limits.
  ratePerMinute  Int     @default(2)
  // Optional filter criteria captured at campaign-create time, JSON-encoded.
  filterDef     Json?
  startsAt      DateTime?
  completedAt   DateTime?
  business      Business @relation(fields: [businessId], references: [id])
  targets       CampaignTarget[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([businessId, status])
}

model CampaignTarget {
  id            String   @id @default(cuid())
  campaignId    String
  customerId    String
  status        CampaignTargetStatus @default(pending)
  callSessionId String?     // populated once a call has been placed
  lastAttemptAt DateTime?
  attempts      Int      @default(0)
  outcomeNote   String?  @db.Text
  campaign      Campaign @relation(fields: [campaignId], references: [id])
  customer      Customer @relation(fields: [customerId], references: [id])
  createdAt     DateTime @default(now())
  @@unique([campaignId, customerId])
  @@index([campaignId, status])
}

// --- Two-way SMS conversations ------------------------------------------

enum SmsTurnRole {
  agent
  customer
  system
  tool
}

model SmsThread {
  id            String   @id @default(cuid())
  businessId    String
  customerId    String?
  phoneNumber   String   // The customer's number (E.164).
  status        String   @default("open")   // open | closed
  lastInboundAt DateTime?
  lastOutboundAt DateTime?
  business      Business @relation(fields: [businessId], references: [id])
  messages      SmsMessage[]
  toolCalls     SmsToolCall[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([businessId, phoneNumber])
  @@index([businessId, status, updatedAt])
}

model SmsMessage {
  id         String   @id @default(cuid())
  threadId   String
  role       SmsTurnRole
  body       String   @db.Text
  externalId String?  // Twilio message id
  thread     SmsThread @relation(fields: [threadId], references: [id])
  createdAt  DateTime @default(now())
  @@index([threadId, createdAt])
}

model SmsToolCall {
  id         String   @id @default(cuid())
  threadId   String
  toolName   String
  input      Json
  output     Json
  isError    Boolean  @default(false)
  latencyMs  Int
  createdAt  DateTime @default(now())
  thread     SmsThread @relation(fields: [threadId], references: [id])
  @@index([threadId, createdAt])
}

// --- GTM / outbound sales engine (internal tooling) ---------------------
// NOT part of the customer-facing product. This is how WE find prospective
// SMB customers and call them with an AI sales rep to sell Frontdesk itself.
// Deliberately kept on its own data island — no Business/Customer relations —
// so internal sales tooling can never leak into a tenant's data.

enum ProspectStatus {
  new            // sourced, not yet qualified
  qualified      // passed the fit filter — eligible to call
  disqualified   // filtered out by the qualifier
  queued         // attached to a running campaign
  contacted      // at least one call attempt made
  converted      // booked a demo
  lost           // not interested / unreachable / bad fit
  do_not_call    // suppressed — never call again
}

enum ProspectDisposition {
  demo_booked
  callback_requested
  not_interested
  no_answer
  voicemail
  wrong_number
  bad_fit
  gatekeeper_blocked
  do_not_call
}

model Prospect {
  id               String   @id @default(cuid())
  // --- Sourcing --------------------------------------------------------
  source           String              // "google_places" | "csv" | "manual"
  externalId       String?             // e.g. Google Places place_id
  businessName     String
  vertical         Vertical
  phone            String?             // E.164
  website          String?
  address          String?
  city             String?
  region           String?             // state / province
  postalCode       String?
  country          String   @default("US")
  timezone         String   @default("America/Los_Angeles")
  lat              Float?
  lng              Float?
  rating           Float?              // Google rating, 0–5
  reviewsCount     Int?
  ownerName        String?
  // --- Qualification ---------------------------------------------------
  status           ProspectStatus @default(new)
  score            Int?                // 0–100 fit score from the qualifier
  qualificationNote String? @db.Text
  disposition      ProspectDisposition?
  doNotCall        Boolean  @default(false)
  // --- Contact tracking ------------------------------------------------
  attempts         Int      @default(0)
  lastContactedAt  DateTime?
  // --- Demo (set when an SDR call books one) ---------------------------
  demoAt           DateTime?
  demoContactName  String?
  demoContactEmail String?
  targets          OutreachTarget[]
  calls            OutreachCall[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@unique([source, externalId])
  @@index([status, vertical])
  @@index([phone])
}

model OutreachCampaign {
  id             String   @id @default(cuid())
  name           String
  status         CampaignStatus @default(draft)
  // Plain-English goal, pitch, and offer — injected into the SDR system prompt.
  goal           String   @db.Text
  pitch          String   @db.Text
  offer          String?  @db.Text
  repName        String   @default("Alex")   // the name the AI rep introduces itself with
  // Targeting filter captured at create time, JSON-encoded.
  filterDef      Json?
  // Pacing & compliance.
  quietStartHour Int      @default(20)
  quietEndHour   Int      @default(9)
  ratePerMinute  Int      @default(2)
  maxAttempts    Int      @default(3)
  callerId       String?              // E.164 we dial from (display label)
  startsAt       DateTime?
  completedAt    DateTime?
  targets        OutreachTarget[]
  calls          OutreachCall[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([status])
}

model OutreachTarget {
  id            String   @id @default(cuid())
  campaignId    String
  prospectId    String
  status        CampaignTargetStatus @default(pending)
  attempts      Int      @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?            // earliest time to (re)try — set for callbacks/retries
  outcomeNote   String?  @db.Text
  campaign      OutreachCampaign @relation(fields: [campaignId], references: [id])
  prospect      Prospect @relation(fields: [prospectId], references: [id])
  calls         OutreachCall[]
  createdAt     DateTime @default(now())
  @@unique([campaignId, prospectId])
  @@index([campaignId, status])
}

model OutreachCall {
  id               String   @id @default(cuid())
  prospectId       String
  campaignId       String?
  targetId         String?
  vapiCallId       String?  @unique
  direction        CallDirection @default(outbound)
  status           String   @default("in_progress")   // in_progress | completed | failed
  disposition      ProspectDisposition?
  fromNumber       String
  toNumber         String
  startedAt        DateTime @default(now())
  endedAt          DateTime?
  durationSec      Int?
  recordingUrl     String?
  summary          String?  @db.Text
  transcript       String?  @db.Text
  cost             Float?
  // Demo booked on this call, if any.
  demoAt           DateTime?
  demoContactName  String?
  demoContactEmail String?
  prospect         Prospect @relation(fields: [prospectId], references: [id])
  campaign         OutreachCampaign? @relation(fields: [campaignId], references: [id])
  target           OutreachTarget?   @relation(fields: [targetId], references: [id])
  turns            OutreachTurn[]
  toolCalls        OutreachToolCall[]
  createdAt        DateTime @default(now())
  @@index([prospectId, startedAt])
  @@index([campaignId, startedAt])
}

model OutreachTurn {
  id        String   @id @default(cuid())
  callId    String
  role      TurnRole
  text      String   @db.Text
  startedAt DateTime @default(now())
  call      OutreachCall @relation(fields: [callId], references: [id])
  @@index([callId, startedAt])
}

model OutreachToolCall {
  id        String   @id @default(cuid())
  callId    String
  toolName  String
  input     Json
  output    Json
  isError   Boolean  @default(false)
  latencyMs Int
  createdAt DateTime @default(now())
  call      OutreachCall @relation(fields: [callId], references: [id])
  @@index([callId, createdAt])
}

// Do-not-call suppression list. Checked before every outbound dial.
model SuppressionEntry {
  id        String   @id @default(cuid())
  phone     String   @unique          // E.164
  reason    String                    // opted_out | complaint | wrong_number | manual
  note      String?
  createdAt DateTime @default(now())
}
