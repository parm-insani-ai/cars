# Copy to .env.local and fill in.

# Postgres (Neon, Supabase, or local). For local dev, SQLite works via file: URL
# after swapping the provider in prisma/schema.prisma.
DATABASE_URL="postgresql://user:pass@localhost:5432/revline?schema=public"

# Anthropic
ANTHROPIC_API_KEY="sk-ant-..."

# Twilio (SMS). Leave blank to use the no-op mock adapter.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# SendGrid (email). Leave blank for the no-op mock adapter.
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="reply@example-dealer.com"

# Inngest (background workflows). Dev server auto-detects.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Feature flags
ALLOW_AUTOPILOT_SEND="false"

# --- GTM / outbound sales engine (internal tooling) --------------------
# Used by the operator to source SMB prospects and call them with an AI sales
# rep. Not part of what customers get. All optional — leave blank to run the
# engine in mock mode (synthetic prospects, calls skipped with a clear note).
GOOGLE_PLACES_API_KEY=""
VAPI_OUTREACH_ASSISTANT_ID=""
VAPI_OUTREACH_PHONE_NUMBER_ID=""
OUTREACH_COMPANY_NAME="insani"
